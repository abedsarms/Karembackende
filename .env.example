# ── required ──────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-bot-token
WEBAPP_URL=https://your-domain.com          # public HTTPS URL of this server (Mini App URL in BotFather)
ADMIN_TOKEN=change-me-to-a-long-random-string
ADMIN_IDS=111111111                          # Telegram ids that get "new withdrawal" messages

# ── optional ──────────────────────────────────────────────
PORT=3000
BOT_USERNAME=KAReM_Bot                       # auto-detected via getMe if empty
DB_PATH=./data/karem.db
TRUST_PROXY=1                                # set 1 when behind nginx/Cloudflare (reads X-Forwarded-For)
MAX_ACCOUNTS_PER_DEVICE=1
MAX_ACCOUNTS_PER_IP=5                        # more new accounts/24h from one IP → flagged (no referral/withdraw)

FP_IP_RULE=1                                 # same hardware fingerprint + same IP = same device (0 to disable)
SUB_RECHECK_SEC=1800                         # how often finished subscribe tasks are re-verified
USER_RATE_PER_MIN=40                         # max POST requests per user per minute

# ── ad tasks (HTTPS links from your ad network; {sid} and {uid} are replaced) ──
AD1_URL=https://your-ad-network.example/click?subid={sid}
AD2_URL=
AD3_URL=
# Optional server-to-server confirmation (postback). Give the network this URL:
#   https://your-domain.com/api/postback?secret=<ADS_POSTBACK_SECRET>&sid={sid}
ADS_POSTBACK_SECRET=
AD1_POSTBACK=0                               # 1 = claim only allowed after the postback arrived
SPIN_AD_URL=

# ── subscribe tasks (the bot MUST be an admin of each channel) ──
SUB1_CHANNEL=@your_channel_one
SUB1_URL=https://t.me/your_channel_one
SUB2_CHANNEL=@your_channel_two
SUB2_URL=https://t.me/your_channel_two

# ── local development only (never in production) ──
# DEV_MODE=1   then open  http://localhost:3000/?dev=12345
